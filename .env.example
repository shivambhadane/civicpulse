# Google Maps API Key (Required for map tiles & reverse geocoding)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyYourActualGoogleMapsApiKeyHere

# OpenAI API Key (Optional — fallback rule engine will run if not set)
OPENAI_API_KEY=sk-proj-YourOpenAiKeyHere

# Supabase Credentials (Optional — local persistent fallback active by default)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
